# Backend Environment Variables (Optional for Development)

# Note: In production, API keys should be provided by the user through the web interface
# These environment variables are only for local development and testing

# Groq API Key (Optional - use user-provided keys in production)
# GROQ_API_KEY=your_groq_api_key_here

# Database URL (if applicable)
# DATABASE_URL=

# Other configuration
# DEBUG=False
